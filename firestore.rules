rules_version = '2';
// Règles de sécurité ASSMATIA.
// - Seule l'assistante maternelle (nannyId == uid) écrit et lit ses données.
// - Les parents lisent uniquement sharedPlannings / monthlySummaries dont
//   parentEmails contient leur e-mail, à condition qu'il soit vérifié
//   (email_verified) : impossible de se faire passer pour un parent invité.
// - Aucune écriture parent (hors leur propre profil users/{uid}).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && resource.data.nannyId == request.auth.uid;
    }
    function writesAsOwner() {
      return signedIn()
        && request.resource.data.nannyId == request.auth.uid
        && (resource == null || resource.data.nannyId == request.auth.uid);
    }
    function isNanny() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'nanny';
    }
    function parentAllowed() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in resource.data.parentEmails;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Le rôle est fixé à la création et ne peut plus changer.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['nanny', 'parent'];
      allow update: if false;
      // Suppression de compte (RGPD).
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Données privées de l'assistante maternelle (fiscal inclus).
    match /{col}/{id} {
      allow read: if col in ['children', 'contracts', 'dailyLogs', 'taxScales', 'settings', 'leavePeriods', 'lockedSummaries', 'paidLeaves']
        && isOwner();
      allow create, update: if col in ['children', 'contracts', 'dailyLogs', 'taxScales', 'settings', 'leavePeriods', 'lockedSummaries', 'paidLeaves']
        && isNanny() && writesAsOwner();
      allow delete: if col in ['children', 'contracts', 'dailyLogs', 'taxScales', 'settings', 'leavePeriods', 'lockedSummaries', 'paidLeaves']
        && isOwner();
    }

    // Demandes des parents (absence, retard) : le parent propose, l'assistante
    // maternelle décide. Le parent ne peut créer qu'une demande « en attente »
    // pour un enfant qui lui est partagé ; il ne peut ni la modifier ni la valider.
    function myEmail() { return request.auth.token.email.lower(); }
    function verifiedParent() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    match /absenceRequests/{id} {
      allow read: if isOwner() || (verifiedParent() && resource.data.parentEmail == myEmail());
      allow create: if verifiedParent()
        && request.resource.data.parentEmail == myEmail()
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/sharedPlannings/$(request.resource.data.childId))
        && myEmail() in get(/databases/$(database)/documents/sharedPlannings/$(request.resource.data.childId)).data.parentEmails
        && request.resource.data.nannyId == get(/databases/$(database)/documents/sharedPlannings/$(request.resource.data.childId)).data.nannyId;
      allow update: if isOwner() && request.resource.data.nannyId == resource.data.nannyId
        && request.resource.data.parentEmail == resource.data.parentEmail
        && request.resource.data.childId == resource.data.childId;
      allow delete: if isOwner();
    }

    // Vues partagées en lecture seule.
    match /sharedPlannings/{childId} {
      allow read: if isOwner() || parentAllowed();
      allow create, update: if isNanny() && writesAsOwner();
      allow delete: if resource == null || isOwner();
    }
    match /monthlySummaries/{id} {
      allow read: if isOwner() || parentAllowed();
      allow create, update: if isNanny() && writesAsOwner();
      allow delete: if resource == null || isOwner();
    }
  }
}
